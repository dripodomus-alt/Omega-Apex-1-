# Canonical alias of prodution.env for tooling that expects production.env.
# Keep this file in sync with prodution.env.

OMEGA_ENV_PATH=production.env
OMEGA_RUNTIME_MODE=live
EXECUTION_MODE=live
LIVE_TRADING=1
CONFIRM_MAINNET_EXECUTION=I_UNDERSTAND_POLYGON_MAINNET_RISK
API_FRONTEND_TOKEN_REQUIRED=true

CHAIN_ID=137
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_WSS_URL=wss://polygon-bor-rpc.publicnode.com
PRIMARY_READ_RPC_URL=https://polygon-rpc.com
PRIMARY_WSS_URL=wss://polygon-bor-rpc.publicnode.com
BROADCAST_RPC_URL=https://polygon-rpc.com
BROADCAST_WSS_URL=wss://polygon-bor-rpc.publicnode.com
FORK_UPSTREAM_RPC_URL=https://polygon-rpc.com
FORK_RPC_URL=http://127.0.0.1:8545
FORK_SIM_RPC_URL=http://127.0.0.1:8545
START_FOUNDRY_FORK=true

DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/omega
CLOUD_SQL_DSN=postgresql://user:pass@127.0.0.1:5432/omega
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true
REDIS_KEY_PREFIX=omega_v5

EXECUTOR_WALLET=0x0000000000000000000000000000000000000000
EXECUTOR_PRIVATE_KEY=0xREPLACE_WITH_SECRET_MANAGER
PRIVATE_KEY=0xREPLACE_WITH_SECRET_MANAGER
PROFIT_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000
EXECUTOR_CONTRACT_ADDR=0x0000000000000000000000000000000000000000

MEV_ENABLED=false
MEV_PUBLIC_FALLBACK_ENABLED=false
RPC_QUOTA_ENFORCEMENT=true
RPC_PLAN_NAME=production
RPC_REQUEST_UNITS_LIMIT=3000000
RPC_RPS_LIMIT=25
