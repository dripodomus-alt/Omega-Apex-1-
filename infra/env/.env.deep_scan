# .env.deep_scan
# Strategy: Prioritize breadth over speed. Scans the entire market for hidden gems.
# Derived from benchmarks showing system can handle 100+ tokens / 20 pools but with higher latency.
# Acceptable for offline or less time-sensitive discovery of long-tail opportunities.
SCANNER_MODE=rust
TARGET_TOKENS="*"
MIN_TVL_USD=50000
RPC_QUOTA_ENFORCEMENT=true
RPC_RPS_LIMIT=15
OMEGA_RUNTIME_MODE=dry_run
EXECUTION_MODE=dry_run
# Use this for deep market exploration. Monitor JSON reports for latency.
