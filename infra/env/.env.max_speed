# .env.max_speed
# Strategy: Prioritize speed over breadth. Focus on major token pairs.
# Derived from benchmarks showing optimal low-latency at ~25 tokens / 5 pools-per-pair.
# Use when multiplier stays >8x and Rust time <100ms.
SCANNER_MODE=rust
TARGET_TOKENS="USDC,WETH,WBTC,MATIC,USDT,DAI"
MIN_TVL_USD=500000
RPC_QUOTA_ENFORCEMENT=true
RPC_RPS_LIMIT=25
OMEGA_RUNTIME_MODE=dry_run
EXECUTION_MODE=dry_run
# Swap this file in for competitive, low-latency markets.
