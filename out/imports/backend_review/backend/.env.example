# APEX_OMEGA — Environment Variables
# Copy to .env and fill in real values. All RPC vars have public fallbacks.

# ── MongoDB ───────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=apex_omega

# ── Runtime ───────────────────────────────────────────────────
MULTI_CHAIN_SCAN_INTERVAL_SEC=120
RPC_SCAN_INTERVAL_MINUTES=15
WS_PUSH_INTERVAL_SEC=3

# ── Per-chain RPC (optional — public nodes used if unset) ─────
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BNB_RPC_URL=https://bsc-dataseed1.binance.org
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
OP_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc
FTM_RPC_URL=https://rpcapi.fantom.network
ZKSYNC_RPC_URL=https://mainnet.era.zksync.io
LINEA_RPC_URL=https://rpc.linea.build

# ── Legacy Polygon (Alchemy) ──────────────────────────────────
ALCHEMY_HTTP_1=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Live execution (disabled by default) ─────────────────────
LIVE_EXECUTION=false
