{
  "name": "apex-omega-v5-merged-runtime",
  "private": true,
  "version": "5.2.0",
  "description": "Merged Python, Rust, and TypeScript control surface for the Omega V5 arbitrage engine.",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "npm run build:ui && npm run build:server && npm run build:rpc",
    "build:ui": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:rpc": "npm --prefix vendor/web3-rpc-provider run build",
    "lint": "tsc --noEmit",
    "test": "npm --prefix vendor/web3-rpc-provider test -- --runInBand",
    "test:contract-sync": "tsx scripts/contract-sync-test.ts",
    "test:signing-hash": "tsx scripts/signing-hash-test.ts",
    "test:invariants": "tsx scripts/invariant-venue-exclusivity-test.ts",
    "test:broadcast": "tsx scripts/broadcast-test.ts",
    "proof:strategy": "tsx scripts/strategy-proof-audit.ts",
    "routes:dynamic": "tsx scripts/dynamic-route-audit.ts",
    "routes:verify": "tsx scripts/route-engine-verify.ts",
    "fork:calldata": "tsx scripts/fork-calldata-sim.ts",
    "cloud:readiness": "tsx scripts/cloud-readiness.ts",
    "live:cycle": "tsx scripts/live-cycle.ts",
    "live:audit": "tsx scripts/live-opportunity-audit.ts",
    "live:market-ready": "tsx scripts/live-market-ready.ts",
    "perf:metrics": "tsx scripts/perf-metrics.ts",
    "perf:metrics:snapshot": "tsx scripts/perf-metrics.ts --snapshot",
    "live:cycle-5": "tsx scripts/live-cycle-5.ts",
    "lint:rpc": "npm --prefix vendor/web3-rpc-provider exec tsc -- --noEmit -p vendor/web3-rpc-provider/tsconfig.json"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "msgpackr": "^2.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "redis": "^6.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
