# LIQUIDATION_EXECUTOR_ADDRESS='0x8cD1e93eE2DeD4F59e15650c0a16029b6Ad9b951'

# Executor capital-source adapter registry. These must be Omega adapter
# contracts implementing executeAtomic/callback semantics, NOT public routers,
# quoters, factories, Aave Pool, or Balancer Vault.

EXECUTION_ROUTE_TARGET_MODE=capital_source_adapters
ALLOW_POOL_TARGETS_FOR_SCHEMA_CHECK=true
ENABLE_STABLE_SWAP_STRATEGIES=true
AAVE_V3_POOL_ADDRESSES_PROVIDER='0xa97684ead0e402dC232d5A977953DF7ECBaB3CDb'

# --- Liquidation Engine ---
# Discovery and persistence

OMEGA_PRIVATE_TX_METHOD=eth_sendPrivateRawTransaction
OMEGA_RPC_URL=https://nd-018-862-126.p2pify.com/fed08358a89bb03d1cdae5bb8889b91f

# Cold-start and recovery
LIQUIDATION_SCAN_BLOCKS=3000
LIQUIDATION_REORG_BUFFER_BLOCKS=12
LIQUIDATION_INDEX_CHECKPOINT_PATH=out/liquidation_index_checkpoint.json
LIQUIDATION_BORROWER_CACHE_PATH=out/aave_borrowers.json

# Evaluation capacity
LIQUIDATION_MAX_BORROWERS=500
LIQUIDATION_EVALUATION_CONCURRENCY=32
LIQUIDATION_RPC_BATCH_SIZE=100
LIQUIDATION_STATE_MAX_AGE_BLOCKS=2

# Risk-priority queues
LIQUIDATION_CRITICAL_HF_MAX=1.005
LIQUIDATION_WATCH_HF_MAX=1.03
LIQUIDATION_WARM_HF_MAX=1.10
LIQUIDATION_CRITICAL_BATCH_SIZE=200
