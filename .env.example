FORK_RPC_URL='http://anvil-fork:8545'
FORK_SIM_RPC_URL='http://anvil-fork:8545'

# Runtime mode. Keep examples in dry-run; switch through the UI/API or local .env.
OMEGA_RUNTIME_MODE=dry_run

REQUIRE_EXACT_CALL_SUCCESS=true
REQUIRE_FORK_SIMULATION_SUCCESS=true
REQUIRE_RECEIPT_RECONCILIATION=true

ALLOW_UNVERIFIED_POOLS=false
ALLOW_UNKNOWN_TOKENS=false

EXECUTION_MODE=dry_run

