BUNDLE_SIGNER_PRIVATE_KEY='0x... YOUR BUNDLE SIGNER PRIVATE KEY ...'
BUNDLE_SUBMISSION_ENABLED=false
BUNDLE_TARGET_BLOCK_OFFSET=1
BUNDLE_TIMEOUT_MS=2500

